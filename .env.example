# Shop login. Leave empty for no password (anyone with the URL can open the books).
APP_PASSWORD=

# Long random string used to sign the session cookie. Only required if APP_PASSWORD is set.
SESSION_SECRET=

# Google Apps Script web-app URL ending in /exec (optional if GitHub live store is used)
APPS_SCRIPT_URL=

# Must match Apps Script Project Settings → Script Properties → SECRET
APPS_SCRIPT_TOKEN=

# Live shared books (recommended). Fine-grained PAT with Contents: Read and write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=samratryfigures/Hashim-Traders
GITHUB_DATA_PATH=data/live.json
